# Этот файл — только образец. Реальные значения задаются в .env локально
# и как секретные переменные окружения в панели хостинга (например, Railway → Variables) —
# сам .env в git не попадает (см. .gitignore).

# Токен Telegram-бота, выданный @BotFather.
# Бот также понимает альтернативное имя переменной BOT_TOKEN (на случай, если хостинг
# или шаблон деплоя называет её иначе) — используется, если TELEGRAM_BOT_TOKEN не задан.
TELEGRAM_BOT_TOKEN=

# Ключ Groq API (создаётся в консоли Groq: https://console.groq.com/keys).
# Нужен и локально, и на облачном хостинге — там его нужно задать как переменную окружения.
GROQ_API_KEY=

# Модель Groq, которую использует бот.
# Доступ к моделям различается по ключу/аккаунту — Llama 3.x (llama-3.1-8b-instant,
# llama-3.3-70b-versatile) числятся в общей документации Groq, но конкретному ключу
# доступ к ним может быть не выдан (404 model_not_found). openai/gpt-oss-120b проверен
# и работает без доп. разрешений. Чтобы узнать точный список моделей, доступных именно
# вашему ключу: const models = await groq.models.list(); console.log(models.data).
GROQ_MODEL=openai/gpt-oss-120b

# Каталог для постоянного хранилища (data/users.json — история диалогов по каждому чату).
# Локально можно не задавать — по умолчанию используется ./data рядом с проектом.
# На Railway: после подключения Volume (Settings → Volumes → Mount Path) укажите здесь
# ровно тот путь, что задали в качестве Mount Path, например /data.
DATA_DIR=
