# Этот файл — только образец. Реальные значения задаются в .env локально
# и как секретные переменные окружения в панели хостинга (например, Railway → Variables) —
# сам .env в git не попадает (см. .gitignore).

# Токен Telegram-бота, выданный @BotFather.
# Бот также понимает альтернативное имя переменной BOT_TOKEN (на случай, если хостинг
# или шаблон деплоя называет её иначе) — используется, если TELEGRAM_BOT_TOKEN не задан.
TELEGRAM_BOT_TOKEN=

# Ключ(и) Groq API (создаются в консоли Groq: https://console.groq.com/keys).
# GROQ_API_KEY обязателен. GROQ_API_KEY_2 опционален — на случай упора в лимиты.
# ВАЖНО: у Groq лимиты считаются на уровне организации/аккаунта, а не на ключ, так
# что второй ключ реально помогает только если он от ДРУГОГО аккаунта Groq (другой
# email при регистрации) — второй ключ того же аккаунта делил бы тот же лимит и
# ничего бы не добавил. При 429/5xx бот переключается на следующий ключ автоматически.
GROQ_API_KEY=
GROQ_API_KEY_2=

# Модель Groq, которую использует бот.
# Доступ к моделям различается по ключу/аккаунту — Llama 3.x (llama-3.1-8b-instant,
# llama-3.3-70b-versatile) числятся в общей документации Groq, но конкретному ключу
# доступ к ним может быть не выдан (404 model_not_found). openai/gpt-oss-120b проверен
# и работает без доп. разрешений. Чтобы узнать точный список моделей, доступных именно
# вашему ключу: const models = await groq.models.list(); console.log(models.data).
GROQ_MODEL=openai/gpt-oss-120b

# Каталог для постоянного хранилища (data/users.json — история чата бота, data/accounts.json —
# аккаунты Mini App: роль, тариф, лимиты, стрики, напоминания).
# Локально можно не задавать — по умолчанию используется ./data рядом с проектом.
# На Railway: после подключения Volume (Settings → Volumes → Mount Path) укажите здесь
# ровно тот путь, что задали в качестве Mount Path, например /data.
DATA_DIR=

# ── ATA Academy Mini App ────────────────────────────────────────────────────────

# Публичный https-адрес Mini App (кнопка на /start, меню бота и /app). На Railway можно не задавать —
# возьмётся RAILWAY_PUBLIC_DOMAIN (Settings → Networking → Generate Domain).
WEBAPP_URL=

# Голос репетитора (OpenAI TTS). Без ключа приложение говорит системным голосом браузера.
# Голоса: nova | shimmer | alloy. Модель gpt-4o-mini-tts понимает инструкцию стиля голоса.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Разбор рисунков (Vision). Нужен хотя бы один из ключей: GEMINI_API_KEY или OPENAI_API_KEY.
# Если заданы оба — по умолчанию Gemini; VISION_PROVIDER=openai переключает на GPT-4o.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-4o
VISION_PROVIDER=

# Распознавание речи — Whisper на Groq (те же GROQ_API_KEY / _2 с ротацией).
GROQ_STT_MODEL=whisper-large-v3

# Premium в Telegram Stars. Пока PREMIUM_PRICE_STARS пуст — кнопка оплаты неактивна.
PREMIUM_PRICE_STARS=
PREMIUM_DAYS=30

# Тарифы. Free: 15 занятий и 2 разбора рисунков в день, голос — системный голос телефона.
# Premium: занятия без лимита, 5 разборов рисунков в день, заморозка стрика, голос OpenAI.
# PREMIUM_DAILY_AI — необязательный аварийный потолок занятий для Premium (по умолчанию — без лимита).
FREE_DAILY_AI=15
FREE_DAILY_ART=2
PREMIUM_DAILY_AI=
PREMIUM_DAILY_ART=5
# true — голос OpenAI и для бесплатного тарифа (дороже). По умолчанию только Premium/VIP.
TTS_FOR_FREE=

# ── Роли и закрытая школа ───────────────────────────────────────────────────────
# Новые пользователи после онбординга подают заявку; ИИ-функции, CRM и оплата
# открываются после одобрения. Заявки приходят супер-админу в Telegram с кнопками
# «Принять / Отклонить» и видны в приложении в разделе /admin.
#
# Встроенные роли действуют всегда, переменные ниже их ДОПОЛНЯЮТ (не заменяют):
#   супер-админ — @r_design_space
#   VIP         — @nosoksosok1337 (Атахан), @boloyoungg (Рамазан)
#   ребёнок     — @nosoksosok1337 (Атахан)
# Списки через запятую, «@» и регистр не важны. Telegram ID человек узнаёт командой /myid.
# Только ID/username, не имя: имя в Telegram может поставить себе кто угодно.
# Супер-админ должен хотя бы раз открыть бота или приложение — иначе боту некуда слать заявки.

# Супер-админы: получают заявки, полный доступ к /admin. Синонимы: SUPER_ADMINS, SUPER_ADMIN_USERNAMES.
SUPER_ADMIN=
SUPER_ADMIN_IDS=

# Админы школы: /admin, решения по заявкам, ручной Premium (заявки в Telegram не получают).
# Синоним: ADMIN_USERNAME.
ADMIN_USERNAMES=
ADMIN_TELEGRAM_IDS=

# VIP: Premium без оплаты и срока (уроки без лимита, 5 рисунков в день) + подбадривающий
# тон ассистента; проходят в школу без заявки. Синоним: VIP_USERNAME.
VIP_USERNAMES=
VIP_TELEGRAM_IDS=

# Детский режим Мартины (игра и похвала, без исправлений): по умолчанию @nosoksosok1337 (Атахан).
# Синоним: KIDS_USERNAME.
KIDS_USERNAMES=
KIDS_TELEGRAM_IDS=
