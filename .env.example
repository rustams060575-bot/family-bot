# Этот файл — только образец. Реальные значения задаются в .env локально
# и как секретные переменные окружения в панели хостинга (например, Railway → Variables) —
# сам .env в git не попадает (см. .gitignore).

# Токен Telegram-бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Google Gemini API (создаётся в Google AI Studio: https://aistudio.google.com/apikey).
# Нужен и локально, и на облачном хостинге — там его нужно задать как переменную окружения.
GEMINI_API_KEY=

# Модель Gemini, которую использует бот.
# gemini-flash-latest — официальный алиас Google на актуальную стабильную flash-модель:
# конкретные датированные версии (например, gemini-2.5-flash) со временем закрываются
# для новых ключей, а этот алиас продолжает работать без правок кода.
# Чтобы жёстко закрепить версию, впишите её явно, напр. GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-latest

# Каталог для постоянного хранилища (data/users.json — имена, суффиксы, история диалогов).
# Локально можно не задавать — по умолчанию используется ./data рядом с проектом.
# На Railway: после подключения Volume (Settings → Volumes → Mount Path) укажите здесь
# ровно тот путь, что задали в качестве Mount Path, например /data.
DATA_DIR=
